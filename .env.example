# À copier dans Netlify (Site configuration > Environment variables) ou dans un fichier .env.local
# Les deux valeurs se trouvent dans Supabase > Project Settings > API. Elles sont obligatoires.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Facultatif : alerte e-mail à chaque nouvelle demande (voir README, étape 9)
# WEBHOOK_SECRET=une-longue-phrase-secrete
# RESEND_API_KEY=re_xxxxxxxx
# ALERT_EMAIL=ofofdonzo@gmail.com
# ALERT_FROM=Equimarge <alertes@equimarge.fr>   (après avoir validé le domaine dans Resend)

# Facultatif : code de vérification Google Search Console (méthode « Balise HTML », valeur de content="…")
# GOOGLE_SITE_VERIFICATION=
# Facultatif : adresse publique imposée (sinon, sur Netlify, le domaine principal du site)
# SITE_URL=https://equimarge.fr
