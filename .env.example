# À copier dans Netlify (Site configuration > Environment variables) ou dans un fichier .env.local
# Obligatoire : les deux valeurs se trouvent dans Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Alertes à chaque nouvelle demande (voir README, étape 9)
# WEBHOOK_SECRET=une-longue-phrase-secrete          (même phrase que le secret « equimarge_webhook_secret » du Vault Supabase)
# VAPID_PRIVATE_KEY=cle-privee-des-notifications
# SUPABASE_SERVICE_ROLE_KEY=cle-service_role-de-supabase
# Facultatif : e-mail en plus des notifications
# RESEND_API_KEY=re_xxxxxxxx
# ALERT_EMAIL=ofofdonzo@gmail.com
# ALERT_FROM=Equimarge <alertes@equimarge.fr>   (après avoir validé le domaine dans Resend)

# Lecture des factures fournisseurs par Claude (onglet « Recettes », voir README, étape 11)
# ANTHROPIC_API_KEY=sk-ant-...
# Facultatif : autre modèle que claude-opus-5-5 (par exemple claude-haiku-5-5)
# ANTHROPIC_MODEL=

# Abonnement Recettes Pro par Stripe (voir README, étape 12)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_RECETTES=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Facultatif : taux de TVA Stripe ajouté au prix (txr_...) et lectures gratuites par mois (3 par défaut)
# STRIPE_TAX_RATE=
# FACTURES_GRATUITES=3

# Facultatif : code de vérification Google Search Console (méthode « Balise HTML », valeur de content="…")
# GOOGLE_SITE_VERIFICATION=
# Facultatif : adresse publique imposée (sinon, sur Netlify, le domaine principal du site)
# SITE_URL=https://equimarge.fr
